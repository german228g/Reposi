# Токен от @BotFather (НЕ коммитьте реальный токен!)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# MTProto-доступ для создания каналов от имени пользователя.
# Получить на https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# Опционально: бесплатный Groq API (https://console.groq.com)
GROQ_API_KEY=

# Опционально: локальный Ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

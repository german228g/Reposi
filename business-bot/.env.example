# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram ID владельца сервиса (через запятую, если несколько).
# Только эти люди видят /setapi и служебные сообщения.
ADMIN_USER_IDS=

# Ключи ПРИЛОЖЕНИЯ — одни на весь сервис, а не на каждого клиента.
# Получить один раз: my.telegram.org → API development tools.
# Можно не вписывать здесь, а прислать боту: /setapi <api_id> <api_hash>
TG_API_ID=
TG_API_HASH=

# Опционально: бесплатный Groq API (https://console.groq.com)
GROQ_API_KEY=

# Опционально: локальный Ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

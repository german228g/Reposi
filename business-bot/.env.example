# Токен от @BotFather (НЕ коммитьте реальный токен!)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Опционально: бесплатный Groq API (https://console.groq.com) — усиливает ответы
GROQ_API_KEY=

# Опционально: локальный Ollama (http://localhost:11434)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# Язык по умолчанию
DEFAULT_LANG=ru
